#!/bin/sh
#
# Mock remote zfs command (used by sync.sh tests).
#
# Logs each invocation to $MOCK_REMOTE_LOG and serves snapshot lists from
# $MOCK_REMOTE_SNAPSHOTS (tab-separated name<TAB>creation_epoch).
#
echo "remote_zfs $*" >> "$MOCK_REMOTE_LOG"
case "$1" in
  list)
    for a; do FS=$a; done
    # Mimic a receiving host where the target filesystem does not exist yet
    if [ -n "$MOCK_REMOTE_MISSING_FS" ]; then
      echo "cannot open '$FS': dataset does not exist" >&2
      exit 1
    fi
    case " $* " in
      *" -d 1 "*)
        # Mimic an older authorized_keys_commands.sh that only allows -rH
        if [ -n "$MOCK_REMOTE_LEGACY_ONLY" ]; then
          echo "'zfs $*' not allowed" >&2
          exit 1
        fi
        # -d 1: only the target filesystem's own snapshots
        PATTERN="^$FS@" ;;
      *)
        # recursive: child datasets included
        PATTERN="^$FS[@/]" ;;
    esac
    if [ -f "$MOCK_REMOTE_SNAPSHOTS" ]; then
      grep "$PATTERN" "$MOCK_REMOTE_SNAPSHOTS" | sort -t'	' -k2 -n | cut -f1
    fi
    exit 0 ;;
  receive)
    cat > /dev/null
    exit 0 ;;
esac
echo "mock remote_zfs: unhandled: $*" >&2
exit 1
